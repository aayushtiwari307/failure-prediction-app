# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# URL of the Flask ML service (internal - not exposed to the browser)
ML_SERVICE_URL=http://localhost:5001

# Shared secret required to call DELETE /api/predictions (bulk reset).
# Single-user demo scope: a shared secret protects the one destructive
# endpoint rather than implementing full authentication. Leave unset to
# disable bulk delete entirely.
ADMIN_KEY=

# Restrict CORS to this frontend origin in production
CLIENT_ORIGIN=http://localhost:3000

PORT=5000
